<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- MinVer derives the version from git tags. Our release tags are v-prefixed (e.g. v0.6.0), and
         MinVer's default expects an unprefixed tag, so without this it ignores them and falls back to
         0.0.0-alpha.<height>. Strip the leading "v" so v0.6.0 -> 0.6.0.

         There is deliberately no literal version property here or in any .csproj. A version string
         committed to the tree is something an inbound sync can revert, and one did. Deriving the
         version from the release tag makes that drift structurally impossible. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Authors>ResQ Team</Authors>
    <Company>ResQ Software</Company>
    <Copyright>Copyright (c) 2026 ResQ</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/resq-software/dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- S-Tier .NET DX -->
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Global Analysis Settings -->
  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Build-time only (PrivateAssets="all" keeps MinVer out of the produced packages).
       Version is pinned centrally in Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)NUGET_README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
