# Canonical ResQ pre-commit shim — source: resq-software/dev.
# Delegates all logic to `resq pre-commit`; runs `.git-hooks/local-pre-commit`
# as a repo-specific escape hatch if present and executable.

set -euo pipefail

[ -n "${GIT_HOOKS_SKIP:-}" ] && exit 0

PROJECT_ROOT="$(git rev-parse --show-toplevel)"

# ── Resolve resq binary ─────────────────────────────────────────────────────
# PATH first (covers nix develop + ~/.cargo/bin on PATH). Soft-skip otherwise
# so a missing backend never blocks a commit silently — the user sees a hint.
RESQ_BIN=""
if command -v resq >/dev/null 2>&1; then
    RESQ_BIN="resq"
elif [ -x "$HOME/.cargo/bin/resq" ]; then
    RESQ_BIN="$HOME/.cargo/bin/resq"
fi

if [ -n "$RESQ_BIN" ]; then
    "$RESQ_BIN" pre-commit --root "$PROJECT_ROOT" "$@"
else
    # resq CLI absent (e.g. `./scripts/setup.sh` without `nix develop`): do NOT
    # silently skip enforcement — a missing backend must not let staged secrets
    # or large files through. Run an inline fallback mirroring the secret /
    # large-file portion of the canonical `resq pre-commit` gate. Install the
    # CLI (below) to get the full OSV + formatting checks too.
    echo "⚠️  resq not found — running inline fallback checks."
    echo "    For the full gate, enter 'nix develop', or run:"
    echo "      cargo install --git https://github.com/resq-software/crates resq-cli"

    # Large-file guard (1 MB).
    while IFS= read -r _f; do
        [ -f "$_f" ] || continue
        if [ "$(wc -c < "$_f")" -gt 1048576 ]; then
            echo "❌ '$_f' exceeds 1 MB. Large files must not be committed."
            exit 1
        fi
    done < <(git diff --cached --name-only --diff-filter=ACM)

    # Secret scan: prefer gitleaks, else fall back to inline regex patterns.
    if command -v gitleaks >/dev/null 2>&1; then
        if ! gitleaks protect --staged --redact -v >/dev/null 2>&1; then
            echo "❌ Potential secrets detected. Remove them before committing."
            exit 1
        fi
    else
        _staged="$(git diff --cached --unified=0 2>/dev/null || true)"
        if printf '%s' "$_staged" | grep -qE 'AKIA[0-9A-Z]{16}'; then
            echo "❌ AWS access key detected."; exit 1
        fi
        if printf '%s' "$_staged" | grep -qE '(ghp_|ghs_|gho_)[A-Za-z0-9_]{36,}'; then
            echo "❌ GitHub token detected."; exit 1
        fi
        if printf '%s' "$_staged" | grep -qF 'BEGIN PRIVATE KEY'; then
            echo "❌ Private key detected."; exit 1
        fi
        if printf '%s' "$_staged" | grep -qiE 'api[_-]?key[[:space:]]*=[[:space:]]*"[A-Za-z0-9_-]{16,}"'; then
            echo "❌ API key detected."; exit 1
        fi
        if printf '%s' "$_staged" | grep -qiE 'password[[:space:]]*=[[:space:]]*"[^"]{4,}"'; then
            echo "❌ Hardcoded password detected."; exit 1
        fi
    fi
    echo "✅ Inline secret / large-file checks passed (install resq for the full gate)."
fi

# ── Local override ──────────────────────────────────────────────────────────
LOCAL_HOOK="$PROJECT_ROOT/.git-hooks/local-pre-commit"
if [ -x "$LOCAL_HOOK" ]; then
    exec "$LOCAL_HOOK" "$@"
fi
