# Notify (do not auto-mutate) when the NuGet lockfile changes on branch switch.
#
# The canonical post-checkout hook knows Cargo.lock, bun.lock, uv.lock and
# flake.lock — not packages.lock.json — so without this a restore-worthy change
# lands silently in a .NET repo.
#
# Set DOTNET_RESTORE_AFTER_MERGE=1 to auto-run `dotnet restore`.
# Set SKIP_DOTNET_RESTORE=1 to silence everything.
set -euo pipefail

[ -n "${SKIP_DOTNET_RESTORE:-}" ] && exit 0

PREV_HEAD="${1:-}"
NEW_HEAD="${2:-}"
IS_BRANCH_CHECKOUT="${3:-}"

# git also fires this hook for file checkouts, where the refs are unchanged.
[ "$IS_BRANCH_CHECKOUT" = "1" ] || exit 0
[ "$PREV_HEAD" = "$NEW_HEAD" ] && exit 0

CHANGED=$(git diff --name-only "$PREV_HEAD" "$NEW_HEAD" 2>/dev/null || true)
case "$CHANGED" in
    *packages.lock.json*)
        echo "📦 NuGet lockfile changed."
        if [ "${DOTNET_RESTORE_AFTER_MERGE:-0}" = "1" ] && command -v dotnet >/dev/null 2>&1; then
            echo "   Running dotnet restore (DOTNET_RESTORE_AFTER_MERGE=1)..."
            dotnet restore
        else
            echo "   Run 'dotnet restore' to sync; set DOTNET_RESTORE_AFTER_MERGE=1 to auto-run."
        fi
        ;;
esac
